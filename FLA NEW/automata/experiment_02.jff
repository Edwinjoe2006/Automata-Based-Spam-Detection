<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created for JFLAP 7.1 FLA Course-->
<structure>
	<type>fa</type>
	<automaton>
		<!-- The list of states. -->
		<state id="0" name="q0">
			<x>100.0</x>
			<y>180.0</y>
			<initial />
		</state>
		<state id="1" name="q1">
			<x>240.0</x>
			<y>100.0</y>
		</state>
		<state id="2" name="q2">
			<x>380.0</x>
			<y>100.0</y>
		</state>
		<state id="3" name="q3">
			<x>520.0</x>
			<y>100.0</y>
			<final />
		</state>
		<state id="4" name="q4">
			<x>240.0</x>
			<y>260.0</y>
		</state>
		<state id="5" name="q5">
