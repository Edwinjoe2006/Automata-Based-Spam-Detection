<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created for JFLAP 7.1 FLA Course-->
<structure>
	<type>fa</type>
	<automaton>
		<!-- The list of states. -->
		<state id="0" name="Q_INIT">
			<x>80.0</x>
			<y>180.0</y>
			<initial />
		</state>
		<state id="1" name="Q_SUSP">
			<x>260.0</x>
			<y>100.0</y>
		</state>
		<state id="2" name="Q_HIGH">
			<x>440.0</x>
			<y>100.0</y>
		</state>
		<state id="3" name="Q_SPAM">
			<x>620.0</x>
			<y>180.0</y>
			<final />
		</state>
		<state id="4" name="Q_HAM">
			<x>350.0</x>
			<y>280.0</y>
		</state>
		<!-- The list of transitions. -->
		<transition>
			<from>0</from>
			<to>4</to>
			<read>Clean</read>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>Promo</read>
		</transition>
		<transition>
			<from>0</from>
			<to>2</to>
			<read>Phish</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>Urgency</read>
		</transition>
		<transition>
			<from>2</from>
			<to>3</to>
			<read>Phish</read>
		</transition>
		<transition>
			<from>1</from>
			<to>3</to>
			<read>Bonus</read>
		</transition>
	</automaton>
</structure>